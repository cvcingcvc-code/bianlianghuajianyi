{
  "name": "binance-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Automated Binance USD-M Futures trading bot with risk management",
  "scripts": {
    "start": "node src/index.js",
    "start:dry": "cross-env DRY_RUN=true node src/index.js",
    "start:reset-breaker": "node src/index.js --reset-breaker",
    "research": "node src/research/cli.js",
    "research:compare": "node src/research/cli.js --compare",
    "research:holdout-check": "node scripts/check-holdout-readiness.js",
    "test": "node -e \"const fs=require('fs'),path=require('path'),{execFileSync}=require('child_process');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):e.name.endsWith('.test.js')?[path.join(d,e.name)]:[]);execFileSync(process.execPath,['--test',...walk('tests')],{stdio:'inherit'})\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "node-binance-api": "^1.0.32"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
