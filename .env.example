# ============================================================
# Binance Futures Trading Bot - Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- API Credentials ---
# Create at: Binance -> API Management
# PERMISSIONS: Enable Futures (read + trade only, NEVER enable withdraw)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# --- Environment ---
# true = Binance Futures Testnet (https://testnet.binancefuture.com)
# false = Binance Live Futures (REAL MONEY)
BINANCE_TESTNET=true

# --- Trading Pairs ---
TRADING_PAIRS=BTCUSDT,ETHUSDT

# --- Risk Management ---
MAX_LEVERAGE=10
POSITION_SIZE_PCT=5
MAX_OPEN_POSITIONS=3
DAILY_LOSS_CAP_PCT=5
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4

# --- Strategy: EMA Crossover ---
EMA_FAST=9
EMA_SLOW=21
CANDLE_INTERVAL=15m

# --- Execution ---
DRY_RUN=false
MAX_SLIPPAGE=0.005
ORDER_RETRY_ATTEMPTS=3

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- Alerts (Optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# FEISHU_WEBHOOK_URL=

# --- Advanced (Optional) ---
# MAX_NOTIONAL_PER_TRADE=5000
# SIGNAL_COOLDOWN_SECONDS=300
# WS_RECONNECT_DELAY=1000
# DASHBOARD_REFRESH_MS=2000
